# Copy to .env and fill in values. Prefer a dedicated token when possible.
# Never commit real credentials.

# Option A — email / password login (token + ids are discovered automatically)
SLING_EMAIL=you@example.com
SLING_PASSWORD=your-password

# Option B — paste a token from Sling web DevTools (Authorization header)
# SLING_TOKEN=
# SLING_ORG_ID=
# SLING_USER_ID=

# Optional calendar feed settings
ICAL_NAME=Sling Shifts
# ICAL_FEED_TOKEN=choose-a-long-random-secret
